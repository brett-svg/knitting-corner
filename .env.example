# ── Database (Railway Postgres) ─────────────────────────────────────────────
# Inside Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
# Locally, use the public URL from the Postgres service's "Connect" tab.
# Leave empty to run in demo mode with mock data and no auth.
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random chars; signs the session cookie. `openssl rand -base64 48`
AUTH_SECRET=
# Optional comma-separated list. When set, only these emails can create accounts.
ALLOWED_EMAILS=

# ── File storage (Railway Bucket, S3-compatible) ───────────────────────────
# Inside Railway, reference the Bucket service's variables:
#   S3_BUCKET=${{Bucket.BUCKET}}  S3_ENDPOINT=${{Bucket.ENDPOINT}}
#   S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}  S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
#   S3_REGION=${{Bucket.REGION}}
# Leave empty to disable photo/PDF uploads (everything else still works).
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Set to "true" only if your bucket's credentials tab says it needs path-style URLs.
S3_FORCE_PATH_STYLE=

# ── AI label scanning (Anthropic Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Ravelry yarn database (optional, improves scan accuracy) ──────────────
# Create a "basic auth, read only" app at https://www.ravelry.com/pro/developer
# and paste the access key / secret key here.
RAVELRY_USERNAME=
RAVELRY_PASSWORD=
